{
  "name": "@polaris/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polaris shared form-control library. Source-only TSX, built to References/design.md section 9.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "tokens": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "preview": "vite --config vite.preview.config.ts"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "taygeta-ux-animation-components": "github:ReiHarumi/Taygeta-UX-Animation-Components-Library#5f5628d9b4eb64c4e16ed752bb6dd9518fed7c7a"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
